.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# build artifacts / vendored toolchain / generated IDE metadata
node_modules/
dist/
compile_commands.json
idedata.json

# LittleFS image, generated from web/ by `npm run build`
data/

# old full-project backup archive, superseded by git
QlockThreeW32.zip

# credentials of one particular clock; Secrets.example.h is the template
src/Secrets.h

# Python bytecode, from importing scripts/ rather than running it
__pycache__/

# the mock server's stand-in for the clock's LittleFS, seeded on first run
.mockfs/

# the mock server's stand-in for NVS, seeded on first run
.mocknvs.json

# per-clock measurement, not source: the coupling from each cell to that
# clock's light sensor. Produced by scripts/lab.py calibrate.
coupling.json

# the same measurement read back off a clock that made it itself, for
# comparing the two implementations.
clock_coupling.json

# the learned brightness curve while the regulator runs on this side, in
# scripts/regulate.py. Per clock and per room, the same as coupling.json.
curve.json

# measurement logs from scripts/regulate.py, one session each
lauf*.csv
lauf*.cfg
